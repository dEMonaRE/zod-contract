{
  "name": "@aemrezorlu/zod-contract",
  "version": "0.2.0",
  "description": "Zod schemas → OpenAPI 3.1 components + JSON examples. Zero wrapping, zero config.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "bin": {
    "zod-contract": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "demo": "tsx src/cli.ts build fixtures api",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "commander": "^12.1.0",
    "jiti": "^2.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
